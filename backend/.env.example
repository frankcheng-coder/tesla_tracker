# --- Database ---
# For PostGIS-enabled trip storage. Example local value:
#   postgresql+psycopg2://tesla:tesla@localhost:5432/tesla_tracker
DATABASE_URL=postgresql+psycopg2://tesla:tesla@localhost:5432/tesla_tracker

# --- Encryption ---
# Fernet key used to encrypt Tesla refresh/access tokens at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Tesla Fleet API OAuth ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://your-domain.example.com/auth/tesla/callback
TESLA_DEVELOPER_DOMAIN=your-domain.example.com
TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com

# --- App ---
# Comma-separated origins allowed for CORS (the iOS app does not need this, but a web debug client might).
CORS_ORIGINS=*
# When true, mock data endpoints are served and no real Tesla calls are made.
USE_MOCK_DATA=true
