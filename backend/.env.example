# --- Database ---
# For PostGIS-enabled trip storage. Example local value:
#   postgresql+psycopg2://tesla:tesla@localhost:5432/tesla_tracker
DATABASE_URL=postgresql+psycopg2://tesla:tesla@localhost:5432/tesla_tracker

# --- Encryption ---
# Fernet key used to encrypt Tesla refresh/access tokens at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Tesla Fleet API OAuth ---
# TODO(you): get these from https://developer.tesla.com after registering an app.
#            See backend/README.md -> "Connect your own Tesla".
TESLA_CLIENT_ID=            # TODO: Client ID from the Tesla Developer app
TESLA_CLIENT_SECRET=        # TODO: Client Secret from the Tesla Developer app
# TODO: must EXACTLY match an Allowed Redirect URI configured in the portal.
TESLA_REDIRECT_URI=https://your-domain.example.com/auth/tesla/callback
# TODO: the public HTTPS domain hosting your com.tesla.3p.public-key.pem
TESLA_DEVELOPER_DOMAIN=your-domain.example.com
# TODO: choose YOUR region. NA/Asia-Pacific shown; EU is fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com

# --- App ---
# Comma-separated origins allowed for CORS (the iOS app does not need this, but a web debug client might).
CORS_ORIGINS=*
# TODO(you): set this to false to use your REAL Tesla account instead of mock data.
# When false you must have a database (alembic upgrade head) and valid Tesla creds above.
USE_MOCK_DATA=true
